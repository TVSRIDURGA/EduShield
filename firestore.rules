rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : 'guardian';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isClaimsOfficer() {
      return isAuthenticated() && (
        getUserRole() == 'claims_officer' ||
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'claims_officer'
      );
    }

    function isUniversityRep(univId) {
      return isAuthenticated() && (
        isAdmin() ||
        (getUserRole() == 'university' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.universityId == univId)
      );
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';
      allow update: if isOwner(userId) && (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    // Students
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Partner Universities
    match /universities/{univId} {
      allow read: if true; // Public directory for quote selection
      allow write: if isAdmin();
    }

    // Insurance Plans & Rules
    match /insurancePlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businessRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quotes
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        isClaimsOfficer()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        isClaimsOfficer()
      );
      allow delete: if isAdmin();
    }

    // Education Policies
    match /educationPolicies/{policyId} {
      allow read: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        isClaimsOfficer()
      );
      allow create: if isAuthenticated();
      allow update: if isClaimsOfficer() || (
        isAuthenticated() && resource.data.guardianId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Education Claims
    match /educationClaims/{claimId} {
      allow read: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        isClaimsOfficer() ||
        isUniversityRep(resource.data.universityId)
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        isClaimsOfficer() ||
        isUniversityRep(resource.data.universityId)
      );
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'all'
      );
      allow write: if isAuthenticated();
    }

    // Immutable Audit Logs (Append-Only)
    match /auditLogs/{logId} {
      allow read: if isClaimsOfficer() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strictly immutable under Guidewire audit requirements
    }
  }
}
