rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Identity and Authentication Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role Resolution: check token custom claims or read from /users/{uid}
    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : 'guardian');
    }

    function getUniversityId() {
      return request.auth.token.universityId != null
        ? request.auth.token.universityId
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.universityId
            : '');
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserRole() == 'admin'
      );
    }

    function isClaimsOfficer() {
      return isAuthenticated() && (
        request.auth.token.role == 'claims_officer' ||
        getUserRole() == 'claims_officer' ||
        isAdmin()
      );
    }

    function isUniversity() {
      return isAuthenticated() && (
        request.auth.token.role == 'university' ||
        getUserRole() == 'university' ||
        isAdmin()
      );
    }

    function isGuardian() {
      return isAuthenticated() && (
        request.auth.token.role == 'guardian' ||
        getUserRole() == 'guardian' ||
        isAdmin()
      );
    }

    function isUniversityRep(univId) {
      return isAuthenticated() && (
        isAdmin() ||
        (isUniversity() && (getUniversityId() == univId || getUniversityId() == ''))
      );
    }

    // ========================================================
    // 1. User Profiles (/users)
    // ========================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Public signup only permits 'guardian' or 'student'; privileged roles require admin
      allow create: if isOwner(userId) && (
        request.resource.data.role in ['guardian', 'student'] || isAdmin()
      );
      // Users can update their own profile fields but CANNOT alter their own role
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ========================================================
    // 2. Students (/students)
    // ========================================================
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.id == request.auth.uid ||
        isClaimsOfficer() ||
        isAdmin() ||
        isUniversityRep(resource.data.universityId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.guardianId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ========================================================
    // 3. Partner Universities & Catalog (/universities)
    // ========================================================
    match /universities/{univId} {
      allow read: if true; // Public directory for selection
      allow write: if isAdmin();
    }

    // ========================================================
    // 4. Insurance Plans & Actuarial Rules
    // ========================================================
    match /insurancePlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businessRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================
    // 5. Insurance Quotes (/quotes)
    // ========================================================
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        isClaimsOfficer() ||
        isAdmin()
      );
      // Only parents/guardians and admins can generate quotes
      allow create: if isAuthenticated() && (
        request.resource.data.guardianId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        isClaimsOfficer() ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ========================================================
    // 6. Education Policies (/educationPolicies)
    // ========================================================
    match /educationPolicies/{policyId} {
      allow read: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        isClaimsOfficer() ||
        isAdmin() ||
        isUniversityRep(resource.data.universityId)
      );
      // Policies are bound upon payment by guardian or issued by admin
      allow create: if isAuthenticated() && (
        request.resource.data.guardianId == request.auth.uid || isAdmin()
      );
      // Updates permitted to Claims Officers or Policyholder renewal
      allow update: if isClaimsOfficer() || isAdmin() || (
        isAuthenticated() && resource.data.guardianId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ========================================================
    // 7. Education Claims (/educationClaims)
    // ========================================================
    match /educationClaims/{claimId} {
      allow read: if isAuthenticated() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        isClaimsOfficer() ||
        isAdmin() ||
        isUniversityRep(resource.data.universityId)
      );

      // Only policyholder guardians can submit new claims
      allow create: if isAuthenticated() && (
        request.resource.data.guardianId == request.auth.uid || isAdmin()
      );

      // Updates:
      // - Claims Adjusters: Can update status, record decisions, but CANNOT self-approve family claims (separation of duties)
      // - University Registrars: Can certify enrollment and outstanding fee demand notes
      // - Guardians / Students: Can upload additional evidence
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isClaimsOfficer() && resource.data.guardianId != request.auth.uid) ||
        isUniversityRep(resource.data.universityId) ||
        resource.data.guardianId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // ========================================================
    // 8. Notifications (/notifications)
    // ========================================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'all' ||
        isAdmin()
      );
      allow write: if isAuthenticated();
    }

    // ========================================================
    // 9. Immutable Audit Trail (/auditLogs)
    // ========================================================
    match /auditLogs/{logId} {
      allow read: if isClaimsOfficer() || isAdmin() || isUniversity();
      allow create: if isAuthenticated();
      // Strictly immutable: No update or deletion under Guidewire compliance standards
      allow update, delete: if false;
    }
  }
}
